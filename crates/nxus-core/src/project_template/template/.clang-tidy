---
Checks: >
  -*,

  clang-diagnostic-*,
  clang-analyzer-*,

  bugprone-*,
  cert-*,
  cppcoreguidelines-*,
  misc-*,
  modernize-*,
  performance-*,
  portability-*,
  readability-*,

  google-build-using-namespace,
  google-readability-casting,

  -altera-*,
  -android-*,
  -abseil-*,
  -fuchsia-*,
  -hicpp-*,
  -llvm-*,
  -llvmlibc-*,
  -objc-*,
  -openmp-*,
  -zircon-*,

  -cert-err33-c,

  -cppcoreguidelines-pro-type-vararg,
  -cppcoreguidelines-pro-bounds-array-to-pointer-decay,
  -cppcoreguidelines-pro-bounds-pointer-arithmetic,
  -cppcoreguidelines-owning-memory,
  -cppcoreguidelines-avoid-non-const-global-variables,
  -cppcoreguidelines-avoid-c-arrays,
  -cppcoreguidelines-avoid-magic-numbers,

  -clang-diagnostic-unused-command-line-argument,

  -modernize-avoid-c-arrays,
  -modernize-use-trailing-return-type,

  -readability-uppercase-literal-suffix,
  -hicpp-uppercase-literal-suffix,
  -cert-dcl16-c,

  bugprone-unused-return-value,
  bugprone-easily-swappable-parameters,
  bugprone-implicit-widening-of-multiplication-result,
  bugprone-integer-division,
  bugprone-narrowing-conversions,

  cppcoreguidelines-narrowing-conversions,
  cppcoreguidelines-pro-type-cstyle-cast,

  modernize-use-nullptr,
  modernize-use-override,

  performance-unnecessary-copy-initialization,

  readability-qualified-auto,
  readability-redundant-member-init
  readability-identifier-naming,
  readability-braces-around-statements,

WarningsAsErrors: >
  google-build-using-namespace,
  google-readability-casting,

  cppcoreguidelines-pro-type-cstyle-cast,
  cppcoreguidelines-narrowing-conversions

  modernize-use-nullptr,
  modernize-use-override,

  bugprone-integer-division,
  bugprone-narrowing-conversions,

  readability-identifier-naming,
  readability-braces-around-statements,

HeaderFilterRegex: '^(app/include|app/lib|app/.*|app/testing)/.*'
FormatStyle: file

CheckOptions:
  # ---------------------------------------------------------------------------
  # Rust-ish naming policy
  # ---------------------------------------------------------------------------

  # namespaces/modules: services::blinky_service
  - key: readability-identifier-naming.NamespaceCase
    value: lower_case

  # types: BlinkyService, LedBackend, BlinkyConfig
  - key: readability-identifier-naming.ClassCase
    value: CamelCase
  - key: readability-identifier-naming.StructCase
    value: CamelCase
  - key: readability-identifier-naming.EnumCase
    value: CamelCase
  - key: readability-identifier-naming.TypeAliasCase
    value: CamelCase

  # functions/methods: parse_args, run, set_led
  - key: readability-identifier-naming.FunctionCase
    value: lower_case
  - key: readability-identifier-naming.MethodCase
    value: lower_case

  # variables/parameters: led_index, period_ms
  - key: readability-identifier-naming.VariableCase
    value: lower_case
  - key: readability-identifier-naming.ParameterCase
    value: lower_case
  - key: readability-identifier-naming.LocalVariableCase
    value: lower_case

  # Private members: m_led_index
  #
  # This is not Rust-like, but it is practical C++ and matches the code we wrote.
  # Pure Rust-ish would be no prefix, lower_case.
  - key: readability-identifier-naming.PrivateMemberPrefix
    value: m_
  - key: readability-identifier-naming.PrivateMemberCase
    value: lower_case

  # Constants/macros: CONFIG_FOO, SMH_FOO, SOME_LIMIT
  - key: readability-identifier-naming.ConstexprVariableCase
    value: UPPER_CASE
  - key: readability-identifier-naming.GlobalConstantCase
    value: UPPER_CASE
  - key: readability-identifier-naming.MacroDefinitionCase
    value: UPPER_CASE

  # Enum constants: Rust enum variants are CamelCase.
  - key: readability-identifier-naming.EnumConstantCase
    value: CamelCase

  # Ignore external/NuttX-ish names and common ABI entrypoints.
  - key: readability-identifier-naming.IgnoredRegexp
    value: '^(main|CONFIG_.*|FAR|OK|ERROR|NULL|TRUE|FALSE|[A-Z0-9_]+)$'

  # ---------------------------------------------------------------------------
  # Braces / readability
  # ---------------------------------------------------------------------------

  - key: readability-braces-around-statements.ShortStatementLines
    value: '0'

  # ---------------------------------------------------------------------------
  # Modernize/performance tweaks
  # ---------------------------------------------------------------------------

  - key: modernize-use-nullptr.NullMacros
    value: 'NULL'

  - key: readability-qualified-auto.AddConstToQualified
    value: 'true'

  # ---------------------------------------------------------------------------
  # Check return value disregarded for specific std functions
  # ---------------------------------------------------------------------------

  - key: bugprone-unused-return-value.AllowCastToVoid
    value: 'true'

  - key: bugprone-unused-return-value.CheckedFunctions
    value: >
      ::aligned_alloc;
      ::asctime_s;
      ::at_quick_exit;
      ::atexit;
      ::bsearch;
      ::bsearch_s;
      ::calloc;
      ::clock;
      ::fclose;
      ::fflush;
      ::fgetc;
      ::fgetpos;
      ::fgets;
      ::fopen;
      ::fread;
      ::freopen;
      ::fseek;
      ::fsetpos;
      ::ftell;
      ::fwrite;
      ::getc;
      ::getchar;
      ::malloc;
      ::memchr;
      ::mktime;
      ::realloc;
      ::remove;
      ::rename;
      ::scanf;
      ::setlocale;
      ::setvbuf;
      ::signal;
      ::strerror;
      ::strtol;
      ::strtoll;
      ::strtoul;
      ::strtoull;
      ::system;
      ::tmpfile;
      ::tmpnam;
      ::ungetc;
      ::vscanf;
      ::wctomb;
      ::wcstol;
      ::wcstoul
...

